{
  "protocol": "Fixed stratified train/validation/test, selection before test",
  "seed": 42,
  "features": [
    "province",
    "category",
    "water_2011",
    "sanitation_2011",
    "refuse_2011",
    "electricity_2011",
    "log_households_2022",
    "household_growth_pct",
    "household_size_2022",
    "formal_share_2022",
    "traditional_share_2022",
    "informal_share_2022",
    "urban_share_2022",
    "rdp_share_2022"
  ],
  "categorical": [
    "province",
    "category"
  ],
  "numeric": [
    "water_2011",
    "sanitation_2011",
    "refuse_2011",
    "electricity_2011",
    "log_households_2022",
    "household_growth_pct",
    "household_size_2022",
    "formal_share_2022",
    "traditional_share_2022",
    "informal_share_2022",
    "urban_share_2022",
    "rdp_share_2022"
  ],
  "model_parameters": {
    "Dummy": {
      "constant": null,
      "random_state": null,
      "strategy": "most_frequent"
    },
    "Logistic regression": {
      "C": 1.0,
      "class_weight": "balanced",
      "dual": false,
      "fit_intercept": true,
      "intercept_scaling": 1,
      "l1_ratio": 0.0,
      "max_iter": 3000,
      "n_jobs": null,
      "penalty": "deprecated",
      "random_state": 42,
      "solver": "lbfgs",
      "tol": 0.0001,
      "verbose": 0,
      "warm_start": false
    },
    "Random forest": {
      "bootstrap": true,
      "ccp_alpha": 0.0,
      "class_weight": "balanced",
      "criterion": "gini",
      "max_depth": 4,
      "max_features": "sqrt",
      "max_leaf_nodes": null,
      "max_samples": null,
      "min_impurity_decrease": 0.0,
      "min_samples_leaf": 5,
      "min_samples_split": 2,
      "min_weight_fraction_leaf": 0.0,
      "monotonic_cst": null,
      "n_estimators": 150,
      "n_jobs": 1,
      "oob_score": false,
      "random_state": 42,
      "verbose": 0,
      "warm_start": false
    },
    "MLP": {
      "architecture": "mlp",
      "balanced": true,
      "batch_size": 32,
      "dropout": 0.15,
      "epochs": 250,
      "l2": 0.01,
      "lr": 0.003,
      "patience": 30,
      "random_state": 42,
      "width": 16
    },
    "Residual network": {
      "architecture": "residual",
      "balanced": true,
      "batch_size": 32,
      "dropout": 0.15,
      "epochs": 250,
      "l2": 0.01,
      "lr": 0.003,
      "patience": 30,
      "random_state": 42,
      "width": 16
    }
  },
  "final_parameters": {
    "architecture": "residual",
    "balanced": true,
    "batch_size": 32,
    "dropout": 0.1,
    "epochs": 250,
    "l2": 0.01,
    "lr": 0.001,
    "patience": 30,
    "random_state": 42,
    "width": 16
  },
  "preprocessing": {
    "numeric": "median imputation then StandardScaler",
    "categorical": "most frequent imputation then one-hot unknown ignored",
    "fit_scope": "training only; inner training only during neural CV"
  },
  "split": {
    "train": 127,
    "validation": 43,
    "test": 43
  },
  "cv": "4-fold stratified seed 42, neural internal 20% early-stopping holdout",
  "decision_threshold": 0.5,
  "target_threshold": 90,
  "environment": {
    "python": "3.12.14",
    "platform": "Linux-6.18.44-x86_64-with-glibc2.39",
    "numpy": "2.3.5",
    "pandas": "2.2.3",
    "scikit_learn": "1.8.0"
  },
  "gradient_check": {
    "method": "central finite difference all parameters on small deterministic networks",
    "MLP_max_absolute_error": 1.12e-10,
    "Residual_max_absolute_error": 1.41e-10
  }
}